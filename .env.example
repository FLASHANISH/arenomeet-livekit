# ArenaMeet — copy to .env for local dev.
# On Vercel, set these same names as environment variables
# (Project Settings -> Environment Variables). Never commit real values.

# --- Video service (LiveKit Cloud) -------------------------------------
# Create a free LiveKit Cloud project (Build plan, $0/month, no card)
# and copy the values from Project -> Settings -> Keys.
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
